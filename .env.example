# Environment read by syncai_backend. main.py calls dotenv.load_dotenv(), which
# resolves `.env` relative to the process cwd — in the robot container that is
# the workspace root (~/robot_ws), whose .env is the real one. This file lists
# only the variables this package reads; the workspace's .env.example carries
# the rest of the compose stack (pgadmin, Temporal's own DB wiring, ...).

# ── Camera (docker compose only; the process itself does not read this) ──
# docker-compose.yml carries no camera: the robot model's file is merged over
# it, and naming the pair here makes every `docker compose` command read both.
# Unset, the backend runs with no camera (POST /whep answers 502).
# G23, USB cameras on this host:
# COMPOSE_FILE=docker-compose.yml:docker-compose.g23.yml
# M20, the perception board's RTSP streams:
# COMPOSE_FILE=docker-compose.yml:docker-compose.m20.yml

# ── DDS (docker-compose.yml only; the process itself does not read these) ──
# Must be the three values the robot stack's compose runs on (the workspace's
# .env). Unset: CycloneDDS on domain 1 with config/cyclonedds.xml. The M20 runs
# Fast DDS on the vendor's domain 0:
# SYNCAI_RMW=rmw_fastrtps_cpp
# SYNCAI_DDS_CONFIG=models/m20/fastdds.xml
# SYNCAI_ROS_DOMAIN_ID=0

# ── Console sign-in (interfaces/rest/auth.py) ──
# The one account. Change the password: the default logs a warning at startup.
# JWT_SECRET unset draws a key per process, so a restart signs everyone out.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=admin
# JWT_SECRET=
# JWT_EXPIRE_SECONDS=3600
# How long one sign-in may be renewed for before the password is asked again.
# JWT_MAX_SESSION_SECONDS=43200

# ── PostgreSQL (database/postgres.py) ──
# The database itself is `<robot_id>_db`, created on first connect.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=syncrobotic
POSTGRES_PASSWORD=syncrobotic

# ── Temporal (tasks/config.py) ──
# `temporal:7233` inside the compose network, `127.0.0.1:7233` on the host.
TEMPORAL_ADDRESS=127.0.0.1:7233

# ── Speech service (gateways/tts) ──
# The syncai_tts container (SyncAI-TTS repo), which owns the kokoro session and
# the speaker. Defaults to the compose service name, `http://syncai_tts:8080`;
# set it to `http://127.0.0.1:8080` when running the backend on the host against
# the service's published port. Read in init_tts_gateway, i.e. after
# load_dotenv, so a value set only here is actually used.
# TTS_SERVICE_URL=http://syncai_tts:8080

# ── Logging (logger.py) ──
# LOG_LEVEL: any stdlib level name (debug, info, warning, error); default info.
# LOG_FORMAT: console (default, coloured, for byobu and `docker compose logs`) or
# json (one object per line, for a log collector).
# LOG_LEVEL=info
# LOG_FORMAT=console

# ── Per-robot system INI (helpers/system_config.py) ──
# [system] robot_id and [map] name live here. Absolute path on purpose; see
# docs/configuration.md.
# SYNCAI_SYSTEM_INI=~/robot_ws/config/system.ini

# ── WebRTC worker (gateways/webrtc, libsyncai_worker.so) ──
# The gateway applies its own floor for these with setdefault just before
# InitWorker, so anything set here wins; the worker freezes its configuration
# under a sync.Once, which is why changing one means restarting the backend.
#
# STUN_SERVERS empty is deliberate on a LAN robot: the console and the robot
# share a subnet, so host candidates are what connect them, and a public STUN
# URL on a robot with no internet only makes ICE gathering wait out a timeout.
STUN_SERVERS=
# TURN_SERVERS=
# TURN_USERNAME=
# TURN_PASSWORD=
# VIDEO_RTP_PORT=5006
# VIDEO_AUDIO_RTP_PORT=5007
# AUDIO_RTP_PORT=5004
