# Environment read by syncai_backend. main.py calls dotenv.load_dotenv(), which
# resolves `.env` relative to the process cwd — in the robot container that is
# the workspace root (~/robot_ws), whose .env is the real one. This file lists
# only the variables this package reads; the workspace's .env.example carries
# the rest of the compose stack (pgadmin, Temporal's own DB wiring, ...).

# ── PostgreSQL (database/postgres.py) ──
# The database itself is `<robot_id>_db`, created on first connect.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=syncrobotic
POSTGRES_PASSWORD=syncrobotic

# ── Temporal (temporal/shared.py) ──
# `temporal:7233` inside the compose network, `127.0.0.1:7233` on the host.
TEMPORAL_ADDRESS=127.0.0.1:7233

# ── Per-robot system INI (helpers/system_config.py) ──
# [system] robot_id and [map] name live here. Absolute path on purpose; see the
# README's "Configuration" section.
# SYNCAI_SYSTEM_INI=~/robot_ws/config/system.ini

# ── WebRTC worker (gateways/webrtc, libsyncai_worker.so) ──
# The gateway applies its own floor for these with setdefault just before
# InitWorker, so anything set here wins; the worker freezes its configuration
# under a sync.Once, which is why changing one means restarting the backend.
#
# STUN_SERVERS empty is deliberate on a LAN robot: the console and the robot
# share a subnet, so host candidates are what connect them, and a public STUN
# URL on a robot with no internet only makes ICE gathering wait out a timeout.
STUN_SERVERS=
# TURN_SERVERS=
# TURN_USERNAME=
# TURN_PASSWORD=
# VIDEO_RTP_PORT=5006
# VIDEO_AUDIO_RTP_PORT=5007
# AUDIO_RTP_PORT=5004
