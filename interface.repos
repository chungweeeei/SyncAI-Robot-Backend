repositories:
  # syncai_common: every generated interface this package imports, including
  # the map gateway's StartMapping / SaveMaps / ResetMapping / Relocalize /
  # IsValid (the first four used to come from SyncAI-Fast-LIO2's `interface`
  # package), ResumeMapping (at or after 46b84f0) and the MappingStatus
  # message behind GET /api/v1/mapping. Since 2026-11 also BeginTask /
  # EndTask / SetRobotState (syncai_robot_state's state machine) and
  # RobotState's two trailing fields, state_message and
  # localization_converged: all of them land with SyncAI-Robot-Interface's
  # feature/robot-state-machine, and until that is on `dev` this backend's
  # gateway fails to import against a checkout of it.
  src/syncai_common:
    type: git
    url: https://github.com/chungweeeei/SyncAI-Robot-Interface.git
    version: dev
