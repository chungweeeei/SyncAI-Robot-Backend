# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# colcon artifacts, if anyone builds this package in place rather than from the
# workspace it is vcs-imported into
build/
install/
log/

# Editor / IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# environment variables (.env.example is the template)
.env

# Claude Code local settings
.claude/settings.local.json

# rosbag2 recordings. docker-compose bind-mounts this directory into the
# container as ~/robot_ws/record (RECORD_DIR overrides it), so bags land here on
# the host. The directory itself is tracked, via .gitkeep, so Docker never has
# to create a missing bind source — it would create it root:root, and the
# container runs as uid 1000.
record/*
!record/.gitkeep

# Optional FAST-LIO2 `interface` package, copied in for a runtime build
# (see the Dockerfile header). Never committed: it belongs to the private fork.
.interface/
